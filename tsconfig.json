{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "agents/**/*.ts",
    "runtime/**/*.ts",
    "domain/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}

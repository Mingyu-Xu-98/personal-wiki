# Docker PostgreSQL defaults for local development and Mac mini alpha.
# Copy to `.env` only if you want to override docker-compose defaults.

POSTGRES_DB=pwh
POSTGRES_USER=pwh
POSTGRES_PASSWORD=pwh_local_dev
PWH_POSTGRES_PORT=54322

# App connection string used by the future PostgreSQL-backed repository adapter.
DATABASE_URL=postgresql://pwh:pwh_local_dev@127.0.0.1:54322/pwh

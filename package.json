{
  "name": "personal-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "An eve-style personal wiki harness for compiling living knowledge into versioned websites.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "demo": "npm run build && node dist/runtime/demo.js",
    "demo:approval": "npm run build && node dist/runtime/demo.js --manual-approval",
    "inspect:agents": "npm run build && node dist/runtime/inspect-agents.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}

PWH_LLM_BASE_URL=https://code.memect.cn/v1
PWH_LLM_WIRE_API=responses
PWH_LLM_API_KEY=replace-with-your-key
PWH_CREATE_AGENT_MODEL=gpt-5.4
PWH_SITE_AGENT_TIMEOUT_MS=45000
PWH_LLM_MAX_OUTPUT_TOKENS=600

# Local PostgreSQL. Run `npm run db:up`, then use this URL for the future DB-backed store adapter.
DATABASE_URL=postgresql://pwh:pwh_local_dev@127.0.0.1:54322/pwh
PWH_POSTGRES_PORT=54322
PWH_AUTH_STORE=postgres
PWH_STUDIO_STORE=postgres
PWH_KNOWLEDGE_STORE=postgres
PWH_BUILD_STORE=postgres
PWH_BUILD_QUEUE=postgres

# Optional cheaper OpenAI-compatible endpoint for bounded build/chat/summarization tasks.
PWH_ECONOMY_LLM_BASE_URL=http://localhost:4000
PWH_ECONOMY_LLM_WIRE_API=chat-completions
PWH_ECONOMY_LLM_API_KEY=replace-with-your-economy-key
PWH_ECONOMY_CHAT_MODEL=
PWH_ECONOMY_SITE_BUILDER_MODEL=

PWH_WIKI_CURATOR_ENABLED=false
PWH_WIKI_CURATOR_MODEL=gpt-5.4
PWH_SITE_AGENTS_ENABLED=false
PWH_SITE_PLANNER_MODEL=gpt-5.4
PWH_SITE_BUILDER_MODEL=
PWH_SITE_CHATBOT_MODEL=
PWH_SUMMARIZER_MODEL=

# Optional image provider. This project currently routes the use case; image UI/API is not connected yet.
PWH_IMAGE_GENERATION_ENABLED=false
PWH_IMAGE_LLM_BASE_URL=
PWH_IMAGE_LLM_API_KEY=replace-with-your-image-key
PWH_IMAGE_MODEL=
